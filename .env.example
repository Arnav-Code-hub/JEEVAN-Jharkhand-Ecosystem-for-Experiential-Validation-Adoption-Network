# Copy to .env and fill in real values. NEVER commit a filled-in .env.
# Every value below is a placeholder. Validated at boot by
# backend/src/shared/config/env.validation.ts — a missing or malformed value
# fails startup with a named error.

# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---- PostgreSQL (required) -----------------------------------------------
# ADR-0001: self-hosted PostgreSQL via Docker Compose. Supabase is not used.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-me
DB_NAME=postgres

# ---- HTTP ----------------------------------------------------------------
# Comma-separated allowed origins, or * to allow any. Narrow this before deploying.
CORS_ORIGINS=*
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ---- Observability -------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Redis (required) ----------------------------------------------------
# ADR-0004: holds OTP state and refresh tokens. Both must survive a restart.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- OTP -----------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Object storage (ADR-0005) -------------------------------------------
# MinIO locally (per docker-compose). For AWS S3, unset STORAGE_ENDPOINT and use
# real IAM credentials — the bucket must stay in ap-south-1 (MeitY, ADR-0014).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=jeevan-media
STORAGE_ACCESS_KEY=jeevan
STORAGE_SECRET_KEY=jeevan-dev-secret

# ---- Media limits (MB) ---------------------------------------------------
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100
MEDIA_MAX_AUDIO_MB=20
MEDIA_MAX_DOCUMENT_MB=15

# ---- Corroboration (ADR-0006) --------------------------------------------
# Two reports of the same category within this radius and window corroborate.
CORROBORATION_RADIUS_METRES=500
CORROBORATION_WINDOW_DAYS=30

# ---- Governance ----------------------------------------------------------
# ADR-0007: org-unit tier whose officers own the G1 gate.
# district (parameter.md) | panchayat (flowchart) | block | state
G1_OWNER_TIER=district

# ---- Auth ----------------------------------------------------------------
# Required when NODE_ENV=production; min 32 characters.
# Left blank in development, an ephemeral per-boot secret is generated instead.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---- Seeding -------------------------------------------------------------
# Government accounts are never self-registered. Set this and run `npm run seed`
# to create the first state administrator; it enrols TOTP on first sign-in.
# SEED_ADMIN_EMAIL=

