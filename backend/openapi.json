          "channel": {
            "type": "string",
            "enum": [
              "web",
              "mobile",
              "whatsapp",
              "voice"
            ]
          },
          "citizenName": {
            "type": "string",
            "example": "Rajesh Kumar"
          },
          "citizenPhone": {
            "type": "string",
            "example": "+919876543210"
