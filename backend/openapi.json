  "info": {
    "title": "JEEVAN API",
    "description": "Jharkhand Ecosystem for Experiential Validation Adoption Network",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateHeiDomainDto": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "example": "bitmesra.ac.in"
          },
          "institutionName": {
            "type": "string",
            "example": "Birla Institute of Technology, Mesra"
          },
          "orgUnitId": {
            "type": "string",
            "description": "HEI-tier org unit students are attached to"
          }
        },
        "required": [
          "domain",
          "institutionName"
        ]
      },
      "SetActiveDto": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "isActive"
        ]
      },
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "+919876543210",
            "description": "E.164 phone number (citizens) or email address (all other roles)"
          }
        },
        "required": [
          "identifier"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "+919876543210"
          },
          "otp": {
            "type": "string",
            "example": "482913"
          },
          "totp": {
            "type": "string",
            "example": "123456",
            "description": "TOTP code. Required for government roles (parameter.md §2)."
          }
        },
        "required": [
          "identifier",
          "otp"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
